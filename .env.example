# Neon Postgres (injected by `neon checkout` / `neon env pull`)
DATABASE_URL=

# Managed Better Auth (`auth: true` in neon.ts, then `neon deploy`)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Object Storage (injected after `neon deploy` with a bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Neon Function URL (from `neon functions get review`)
NEXT_PUBLIC_REVIEW_FN_URL=

# Optional: GitHub token raises rate limits when fetching public PR diffs
GITHUB_TOKEN=

# Optional: used only by the local Next.js fallback when the Function isn't deployed
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
