# Neon Postgres (injected by `neon checkout` / `neon env pull`)
DATABASE_URL=

# Managed Better Auth (`auth: true` in neon.ts, then `neon deploy`)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Object Storage (injected after `neon deploy` with a bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Neon Function URL (from `neon functions get review`)
NEXT_PUBLIC_REVIEW_FN_URL=

# Public app URL (used in PR review links)
APP_URL=http://localhost:3000

# Optional: GitHub token raises rate limits when fetching public PR diffs
GITHUB_TOKEN=

# GitHub App (from `npm run github:register`)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=rivet-github-app.pem
GITHUB_APP_SLUG=
# Local webhook proxy (set by `npm run github:webhook`)
# GITHUB_WEBHOOK_PROXY_URL=

# Gemini (preferred for AI code review). Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias for the same key:
# GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-pro

# Optional Neon AI Gateway fallback when Gemini is not set
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
